{
  "name": "refundit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "tsx supabase/seed/seed.ts",
    "db:types": "supabase gen types typescript --remote > lib/shared/database.types.ts.tmp && mv lib/shared/database.types.ts.tmp lib/shared/database.types.ts",
    "db:push": "supabase db push --remote",
    "spike": "tsx scripts/agent-spike.ts",
    "eval:extract": "tsx --env-file=.env.local --conditions=react-server lib/receipts/eval/extract.ts",
    "test:receipts": "tsx lib/receipts/eval/cases.ts",
    "stripe:demo-account": "tsx scripts/stripe-connect-demo.ts",
    "eval:identify": "tsx --env-file=.env.local --conditions=react-server lib/receipts/eval/identify.ts",
    "demo": "tsx --env-file=.env.local --conditions=react-server scripts/demo-account.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "driver.js": "1.10.2",
    "hai-agents": "^1.3.2",
    "heic-convert": "^2.1.0",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.70.0",
    "mailparser": "^3.14.2",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "openai": "^7.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
