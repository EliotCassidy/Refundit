{
  "name": "refundit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "tsx supabase/seed/seed.ts",
    "db:types": "supabase gen types typescript --remote > lib/shared/database.types.ts.tmp && mv lib/shared/database.types.ts.tmp lib/shared/database.types.ts",
    "db:push": "supabase db push --remote",
    "spike": "tsx scripts/agent-spike.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "hai-agents": "^1.3.2",
    "heic-convert": "^2.1.0",
    "next": "16.4.5",
    "openai": "^7.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
