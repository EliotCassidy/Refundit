# Copy to .env.local and fill in. Never commit real values.
# Same variables must be set in Vercel (Project → Settings → Environment Variables).

# ---------- App ----------
# Public URL of the app (Vercel URL in prod/preview). Used to build webhook URLs.
APP_URL=http://localhost:3000
# Random secret for server-to-server calls (/api/claims → /api/claims/:id/submit). `openssl rand -hex 32`
INTERNAL_API_KEY=

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM (OpenAI-compatible API, used through lib/shared/llm.ts) ----------
# H Company Models API. Switching model = change these values, never the code.
# Key: platform.hcompany.ai/?product=modelsapi · Docs: hub.hcompany.ai/models-api
# Fallback if receipt reading is poor: LLM_MODEL=holo4-27b
LLM_URL=https://api.hcompany.ai/v1
LLM_API_KEY=
LLM_MODEL=holo4-35b-a3b

# ---------- H Company Agents API (Dev 2) ----------
# Keys: platform.hcompany.ai/settings/api-keys. Docs: hub.hcompany.ai/agents-api
HAI_API_KEY=
# Secret used to verify X-H-Webhook-Signature (HMAC-SHA256 of "{timestamp}.{raw_body}")
H_WEBHOOK_SECRET=
AGENT_ID=h/web-surfer-flash
# true = agent stops before the final submit. Keep true unless doing a verified real run.
AGENT_DRY_RUN=true
# true = skip H entirely, /submit + /sync simulate a run (unblocks Dev 1)
AGENT_MOCK=true

# ---------- Email: one dedicated Gmail account (Dev 2) ----------
# Sends complaints (email fallback) and receives brand replies on per-claim plus addresses
# (refundit.reclamations+claim-xxxxxxxx@gmail.com). Needs 2-Step Verification + an app password
# (Google Account → Security → App passwords). Limit ~500 recipients / 24 h.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Linkup (Dev 2, brand contact form / support email lookup) ----------
LINKUP_API_KEY=
# "standard" (default, ~2 s, $0.006) or "deep" (≤30 s, $0.055). One call per brand, never retried.
LINKUP_DEPTH=standard
# Product search fallback (Dev 1): one Linkup call per checked item, only when Open Food Facts finds nothing good
# (~$0.006, never retried, cached). true = enabled.
LINKUP_PRODUCTS=false

# ---------- Gladia (Dev 1, P2 voice input) ----------
GLADIA_API_KEY=

# ---------- Seed script only ----------
SEED_DEMO_EMAIL=demo@refundit.test
SEED_DEMO_PASSWORD=

# ---------- NotCoca demo brand (Dev 2) ----------
# Access key of the NotCoca back-office (/notcoca/admin).
NOTCOCA_ADMIN_KEY=

# ---------- Billing quota (checked in POST /api/receipts) ----------
# Comma-separated emails that bypass the 1 free scan/month (demo/test accounts only).
SCAN_QUOTA_EXEMPT_EMAILS=

# ---------- Stripe (Dev 2) — TEST MODE ONLY (sk_test_…), Connect enabled on the platform ----------
STRIPE_SECRET_KEY=
# Public URL of the NotCoca contact page once deployed (seeds the NotCoca brand), e.g. https://refundit.vercel.app/notcoca/contact
NOTCOCA_CONTACT_URL=
# Signing secret of the Stripe webhook endpoint https://<app>/api/webhooks/stripe (test mode)
STRIPE_WEBHOOK_SECRET=
